&share
 wrf_core = 'ARW',
 max_dom  = 2,
 start_date = '2025-11-03_00:00:00', '2025-11-03_00:00:00',
 end_date   = '2025-11-15_00:00:00', '2025-11-15_00:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   1,   1,
 parent_grid_ratio =   1,   3,
 i_parent_start    =   1,  19,
 j_parent_start    =   1,  19,
 e_we              =  61,  91,
 e_sn              =  61,  91,
 geog_data_res     = 'default', 'default',
 dx = 9000,
 dy = 9000,
 map_proj = 'lambert',
 ref_lat   =  28.61,
 ref_lon   =  77.21,
 truelat1  =  20.0,
 truelat2  =  35.0,
 stand_lon =  77.21,
 geog_data_path = '/data/geog/WPS_GEOG',
/

&ungrib
 out_format = 'WPS',
 prefix = 'GFS',
/

&metgrid
 fg_name = 'GFS',
 io_form_metgrid = 2,
/
