# Copy to .env and fill in. Keys are optional for training/backtests (OpenAQ S3 +
# Open-Meteo are keyless), but the live API needs real feeds: set DATA_GOV_IN_API_KEY
# and FIRMS_MAP_KEY or it has nothing current to serve. No bundled demo data.

# CPCB real-time Air Quality Index (REQUIRED for live serving) -> https://www.data.gov.in/ (free)
DATA_GOV_IN_API_KEY=

# NASA FIRMS fire hotspots (REQUIRED for the stubble-plume layer) -> https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# OpenAQ v3 (historical ground-truth pollutant series from CPCB stations)
# -> free key at https://explore.openaq.org/  (S3 archive path needs no key)
OPENAQ_API_KEY=

# Copernicus CDS (only needed for the optional high-fidelity ERA5 path, extras: gridded)
# -> https://cds.climate.copernicus.eu/  (put URL+key in ~/.cdsapirc instead if you prefer)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Open-Meteo (default ERA5 history + GFS forecast proxy) needs no key.
# Optional paid key raises rate limits: https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# Where data lands (defaults are fine)
VAYUCAST_DATA_DIR=./data

# Optional Postgres mirror of the live pipeline state (see README). Local (non-Docker):
#   postgresql+psycopg://vayucast:vayucast@localhost:5432/vayucast
DATABASE_URL=
