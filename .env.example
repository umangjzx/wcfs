# Copy to .env and fill in. All keys are optional for a first run:
# without them, ingestion falls back to bundled/cached snapshots.

# CPCB real-time Air Quality Index  -> register at https://www.data.gov.in/ (free)
DATA_GOV_IN_API_KEY=

# NASA FIRMS fire hotspots  -> map key from https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# OpenAQ v3 (historical ground-truth pollutant series from CPCB stations)
# -> free key at https://explore.openaq.org/  (falls back to Open-Meteo CAMS if absent)
OPENAQ_API_KEY=

# Copernicus CDS (only needed for the optional high-fidelity ERA5 path, extras: gridded)
# -> https://cds.climate.copernicus.eu/  (put URL+key in ~/.cdsapirc instead if you prefer)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Open-Meteo (default ERA5 history + GFS forecast proxy) needs no key.
# Optional paid key raises rate limits: https://open-meteo.com/en/pricing
OPEN_METEO_API_KEY=

# Where data lands (defaults are fine)
VAYUCAST_DATA_DIR=./data
